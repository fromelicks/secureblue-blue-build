    </logicalmonitor>
    <disabled>
      <monitorspec>
        <connector>eDP-1</connector>
        <vendor>AUO</vendor>
        <product>0xc1a5</product>
        <serial>0x0000c1a5</serial>
      </monitorspec>
    </disabled>
  </configuration>

  <configuration>
    <layoutmode>logical</layoutmode>
    <logicalmonitor>
      <x>0</x>
      <y>0</y>
      <scale>1</scale>
      <primary>yes</primary>
      <monitor>
        <monitorspec>
          <connector>DP-3</connector>
          <vendor>CHD</vendor>
          <product>24MC635</product>
          <serial>0x00000000</serial>
        </monitorspec>
        <mode>
          <width>1920</width>
          <height>1080</height>
          <rate>75.000</rate>
        </mode>
      </monitor>
    </logicalmonitor>
    <disabled>
      <monitorspec>
        <connector>eDP-1</connector>
        <vendor>AUO</vendor>
        <product>0xc1a5</product>
        <serial>0x0000c1a5</serial>
      </monitorspec>
    </disabled>
  </configuration>

  <!-- Lid closed: eDP-1 drops off the bus entirely, so these blocks list the
       external display alone. Without them mutter would use its default
       (correct output, but the panel's preferred mode rather than 75 Hz). -->
  <configuration>
    <layoutmode>logical</layoutmode>
    <logicalmonitor>
      <x>0</x>
      <y>0</y>
      <scale>1</scale>
      <primary>yes</primary>
      <monitor>
        <monitorspec>
          <connector>HDMI-5</connector>
          <vendor>CHD</vendor>
          <product>24MC635</product>
          <serial>0x00000000</serial>
        </monitorspec>
        <mode>
          <width>1920</width>
          <height>1080</height>
          <rate>75.000</rate>
        </mode>
      </monitor>
    </logicalmonitor>
  </configuration>

  <configuration>
    <layoutmode>logical</layoutmode>
    <logicalmonitor>
      <x>0</x>
      <y>0</y>
      <scale>1</scale>
      <primary>yes</primary>
      <monitor>
        <monitorspec>
          <connector>DP-4</connector>
          <vendor>CHD</vendor>
          <product>24MC635</product>
