#!/bin/bash
# Capture immediate GNOME/DRM state around suspend and resume. Continuous hang
# detection and recovery is handled by gnome-hang-monitor.service.

set -u

RUNDIR=/run/gnome-diagnostics
HELPER=/usr/libexec/fromelicks-gnome-hang-monitor
TAG=gnome-diagnostics

log_info() { printf '%s\n' "$*" | systemd-cat -t "$TAG" -p info; }
log_warn() { printf '%s\n' "$*" | systemd-cat -t "$TAG" -p warning; }

case "$1/$2" in
  pre/suspend|pre/hybrid-sleep)
    mkdir -p "$RUNDIR"
    touch "$RUNDIR/system-sleep-active"

    UID_ACTIVE=$($HELPER active-uid 2>/dev/null || true)
    GNOME_PID=""
    if [ -n "$UID_ACTIVE" ]; then
      GNOME_PID=$($HELPER gnome-pid "$UID_ACTIVE" 2>/dev/null || true)
      printf '%s\n' "$UID_ACTIVE" > "$RUNDIR/active-uid"
      printf '%s\n' "$GNOME_PID" > "$RUNDIR/gnome-pid"
    else
      rm -f "$RUNDIR/active-uid" "$RUNDIR/gnome-pid"
    fi

    log_info "suspend: pre-suspend captured (uid=${UID_ACTIVE:-none}, gnome-pid=${GNOME_PID:-none})"
    $HELPER snapshot "pre-suspend snapshot" "$UID_ACTIVE" "$GNOME_PID" 120 standard
    ;;

  post/suspend|post/hybrid-sleep)
    UID_ACTIVE=$(cat "$RUNDIR/active-uid" 2>/dev/null || $HELPER active-uid 2>/dev/null || true)
    GNOME_PID=""
    if [ -n "$UID_ACTIVE" ]; then
      GNOME_PID=$($HELPER gnome-pid "$UID_ACTIVE" 2>/dev/null || true)
      $HELPER snapshot "post-resume immediate snapshot" "$UID_ACTIVE" "$GNOME_PID" 30 standard
    else
      log_warn "resume: no active non-root graphical user found"
    fi

    rm -f "$RUNDIR/system-sleep-active"
    log_info "resume: continuous gnome-hang monitor re-enabled"
    ;;
esac
