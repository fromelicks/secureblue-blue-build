#!/usr/bin/env bash
#
# First-start setup for the MATLAB environment distrobox. Runs as root inside the container
# on every start via init_hooks, so it must be idempotent and cheap once done.
#
# usage: fromelicks-matlab-box-setup <release>     (e.g. R2026a)
#
# A script rather than a ujust recipe: it runs inside the container, where the
# host's just cannot run (it needs a newer glibc than RHEL 9's).
#
# distrobox-enter treats `distrobox:` as progress, `Error:` as fatal, and
# discards everything else, so bulk dnf output goes to the log file only -- one
# stray `Error:` line would kill the enter mid-install.

set -euo pipefail

readonly MATLAB_RELEASE="${1:?usage: ${0##*/} <release>}"
readonly DEST="/opt/matlab/${MATLAB_RELEASE}"
readonly DEPS_STAMP="/var/lib/fromelicks-matlab-deps-${MATLAB_RELEASE}"
readonly LOG='/opt/matlab/setup.log'
readonly DEPS_URL="https://raw.githubusercontent.com/mathworks-ref-arch/container-images/main/matlab-deps/${MATLAB_RELEASE,,}/ubi9/base-dependencies.txt"

log() { printf 'distrobox: matlab-box: %s\n' "$*"; }
fail() { printf 'Error: matlab-box: %s (see %s)\n' "$*" "${LOG}" >&2; exit 1; }

# The list is third-party; a stray header or CRLF would otherwise reach dnf as
# a package name and fail the hook identically on every start.
clean_list() { sed -e 's/#.*//' -e 's/\r//g' -e '/^[[:space:]]*$/d' "$1"; }

if [[ ! -f "${DEPS_STAMP}" ]]; then
    mkdir -p /opt/matlab
    [[ -f "${LOG}" ]] && mv -f "${LOG}" "${LOG}.prev"
    : > "${LOG}"
    log "starting setup at $(date -Is)"

    # Fetched rather than vendored: release- and distro-specific, and changes
    # with every release.
    log 'fetching the MathWorks dependency list'
    deps_list="$(mktemp)"
    curl -sSfL --retry 3 "${DEPS_URL}" -o "${deps_list}" \
        || fail "could not fetch ${DEPS_URL}"
    mapfile -t deps < <(clean_list "${deps_list}")
    rm -f "${deps_list}"
    (( ${#deps[@]} )) || fail 'the dependency list came back empty'

    log "installing ${#deps[@]} dependency packages"
    # Plain dnf, like distrobox's own additional_packages step: the UBI repos
    # carry everything on the list and need no subscription.
    dnf install -y "${deps[@]}" >> "${LOG}" 2>&1 \
        || fail 'the dependency install failed'

    mkdir -p "$(dirname "${DEPS_STAMP}")"
    touch "${DEPS_STAMP}"
    log "setup complete at $(date -Is)"
fi

# ── Entry points ───────────────────────────────────────────────────────────
# Wrappers, not symlinks, because of LD_PRELOAD. secureblue preloads
# hardened_malloc into every host process, and `distrobox enter` forwards it
# into the container where those libraries do not exist. It is fatal rather
# than cosmetic: MATLAB's UI front end (MATLABWindow, a separate CEF process)
# dies the instant it spawns, leaving a parent spinning at 40% CPU with no
# window and no error.
#
# SHELL: distrobox sets a bare `bash`, which MATLAB cannot exec for system().
# The manifest also overrides it container-wide.
for tool in matlab mex mbuild; do
    cat > "/usr/local/bin/${tool}" <<WRAPPER
#!/usr/bin/env bash
unset LD_PRELOAD
export SHELL=/bin/bash
exec "${DEST}/bin/${tool}" "\$@"
WRAPPER
    chmod 0755 "/usr/local/bin/${tool}"
done

# nvidia=true bind-mounts the host's nvidia-modprobe, a Fedora build that
# RHEL 9's glibc cannot load. The CUDA libraries call it on every start and
# print a glibc error each time. It could not load modules from a rootless
# container anyway, and the host has already created the device nodes, so
# cover it with a no-op. distrobox mounts the NVIDIA files before the hooks run.
for modprobe in /usr/bin/nvidia-modprobe /usr/sbin/nvidia-modprobe; do
    if [[ -f "${modprobe}" ]] && ! cmp -s /usr/bin/true "${modprobe}"; then
        mount --bind /usr/bin/true "${modprobe}" ||
            log "could not cover ${modprobe}; CUDA will print glibc errors"
    fi
done

# setupAgenticToolkit() registers its skills by shelling out to `claude`, which
# lives on the host. Without this it falls back to symlinks in ~/.claude/skills
# and the plugin system never learns about the skill packages.
#
# The path has to be resolved rather than left to PATH: distrobox-host-exec
# runs with a minimal host PATH that excludes the Homebrew prefix where
# Claude Code actually lives. /run/host is the host root, so the container can
# look the binary up before asking the host to run it.
cat > /usr/local/bin/claude <<'WRAPPER'
#!/usr/bin/env bash
for dir in /home/linuxbrew/.linuxbrew/bin "${HOME}/.local/bin" /usr/local/bin /usr/bin; do
    # -e/-L rather than -x: the Homebrew entry is an absolute symlink into the
    # Caskroom, which dangles when resolved from inside the container even
    # though it is perfectly good on the host.
    probe="/run/host${dir}/claude"
    if [[ -e "${probe}" || -L "${probe}" ]]; then
        exec distrobox-host-exec "${dir}/claude" "$@"
    fi
done
exec distrobox-host-exec claude "$@"
WRAPPER
chmod 0755 /usr/local/bin/claude
