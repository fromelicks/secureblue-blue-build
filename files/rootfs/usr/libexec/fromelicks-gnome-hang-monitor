#!/bin/bash
# Continuously detect and diagnose a live-but-unresponsive GNOME Shell.
#
# The monitor runs as a constrained system service so it can inspect every
# thread in the user's compositor and recover the session even while the lock
# screen is active. Diagnostic output is written to journald with the
# "gnome-diagnostics" identifier.

set -u

# ${EPOCHREALTIME} renders its decimal separator per locale and the spawn
# latency probe parses it as an integer.
export LC_ALL=C

TAG=gnome-diagnostics
RUNDIR=/run/gnome-diagnostics
SLEEP_MARKER=$RUNDIR/system-sleep-active
SELF=/usr/libexec/fromelicks-gnome-hang-monitor

CHECK_INTERVAL_SECONDS=${CHECK_INTERVAL_SECONDS:-30}
PROBE_TIMEOUT_SECONDS=${PROBE_TIMEOUT_SECONDS:-5}
FAILURE_LIMIT=${FAILURE_LIMIT:-3}
RECOVER_HUNG_SHELL=${RECOVER_HUNG_SHELL:-yes}
RECOVERY_DISABLE_FILE=$RUNDIR/no-recovery

# A compositor thread in uninterruptible sleep inside the NVIDIA kernel driver
# holds every signal pending until the driver call returns, and on 2026-09-21 it
# never did. After SIGTERM the monitor escalates to SIGKILL (which does end a
# TASK_KILLABLE wait), and if the thread is still stuck after the grace period
# it reboots in an orderly way rather than leaving a frozen lock screen that
# only the power button can clear. "log" records the wedge and stops there.
DRIVER_WEDGE_ACTION=${DRIVER_WEDGE_ACTION:-reboot}
DRIVER_WEDGE_GRACE_SECONDS=${DRIVER_WEDGE_GRACE_SECONDS:-60}
DRIVER_WEDGE_KILL_AFTER_SECONDS=${DRIVER_WEDGE_KILL_AFTER_SECONDS:-15}
BLOCKED_TASKS_DUMP_UNIT=fromelicks-sysrq-show-blocked.service

# These decide whether the machine reboots, so a drifted value must not quietly
# shorten the wait. A non-integer ("60s") would make the grace loop's test fail
# and skip straight to the reboot; fall back to the default and clamp to a floor
# instead. An unknown action is treated as "log", the non-destructive choice.
case "$DRIVER_WEDGE_GRACE_SECONDS" in ''|*[!0-9]*) DRIVER_WEDGE_GRACE_SECONDS=60 ;; esac
[ "$DRIVER_WEDGE_GRACE_SECONDS" -ge 30 ] || DRIVER_WEDGE_GRACE_SECONDS=30
case "$DRIVER_WEDGE_KILL_AFTER_SECONDS" in ''|*[!0-9]*) DRIVER_WEDGE_KILL_AFTER_SECONDS=15 ;; esac
[ "$DRIVER_WEDGE_KILL_AFTER_SECONDS" -lt "$DRIVER_WEDGE_GRACE_SECONDS" ] ||
  DRIVER_WEDGE_KILL_AFTER_SECONDS=$((DRIVER_WEDGE_GRACE_SECONDS / 2))
case "$DRIVER_WEDGE_ACTION" in reboot|log) ;; *) DRIVER_WEDGE_ACTION=log ;; esac

# Snapshots run detached from the check loop under this hard bound. A collection
# that outlives it is killed rather than allowed to delay the next health check.
# Routine snapshots must finish inside one check interval, or a collection
# started on one tick is still holding the single in-flight slot on the next and
# the newer request is dropped. The pre-recovery snapshot is the exception: it
# gets a longer budget and pre-empts, because after recovery the loop stops
# probing the old PID anyway, so it cannot delay anything.
SNAPSHOT_TIMEOUT_SECONDS=${SNAPSHOT_TIMEOUT_SECONDS:-25}
FULL_SNAPSHOT_TIMEOUT_SECONDS=${FULL_SNAPSHOT_TIMEOUT_SECONDS:-60}
MIN_TICK_SLEEP_SECONDS=${MIN_TICK_SLEEP_SECONDS:-5}

# timeout(1) sends TERM at the budget and KILL this much later, so real slot
# occupancy is budget + grace. A collection wedged in an uninterruptible /proc
# read is precisely the case where the grace gets used, and precisely the case
# where the machine is sick enough that the next tick matters.
SNAPSHOT_KILL_GRACE_SECONDS=3
FULL_SNAPSHOT_KILL_GRACE_SECONDS=10

# Enforce the single-slot invariant here rather than trusting whoever set the
# environment: this exact drift (a stale 45 s override against a 30 s interval)
# silently disabled the second snapshot of every failure ladder. Leave a tick's
# worth of margin so a collection dispatched mid-tick still clears the slot.
if [ "$SNAPSHOT_TIMEOUT_SECONDS" -gt \
     "$((CHECK_INTERVAL_SECONDS - SNAPSHOT_KILL_GRACE_SECONDS - 2))" ]; then
  SNAPSHOT_TIMEOUT_SECONDS=$((CHECK_INTERVAL_SECONDS - SNAPSHOT_KILL_GRACE_SECONDS - 2))
  [ "$SNAPSHOT_TIMEOUT_SECONDS" -ge 5 ] || SNAPSHOT_TIMEOUT_SECONDS=5
fi

# Starvation classifier. A failed probe means "the compositor did not answer",
# which is also what a machine too loaded to schedule anything looks like.
# These decide which of the two it was.
SPAWN_LATENCY_THRESHOLD_MS=${SPAWN_LATENCY_THRESHOLD_MS:-250}
PSI_CPU_SOME_THRESHOLD=${PSI_CPU_SOME_THRESHOLD:-90}
PSI_IO_FULL_THRESHOLD=${PSI_IO_FULL_THRESHOLD:-60}
PSI_MEM_FULL_THRESHOLD=${PSI_MEM_FULL_THRESHOLD:-25}

log_info() { printf '%s\n' "$*" | systemd-cat -t "$TAG" -p info; }
log_warn() { printf '%s\n' "$*" | systemd-cat -t "$TAG" -p warning; }
log_err() { printf '%s\n' "$*" | systemd-cat -t "$TAG" -p err; }

seconds_ago() {
  date -d "$1 seconds ago" -Iseconds 2>/dev/null || date -Iseconds
}

session_prop() {
  loginctl show-session "$1" -p "$2" --value 2>/dev/null || true
}

# Return the UID of the active local graphical user, never root or the greeter.
get_active_uid() {
  local sid uid name class type state remote active user

  while read -r sid _; do
    [ -n "$sid" ] || continue
    uid=$(session_prop "$sid" User)
    name=$(session_prop "$sid" Name)
    class=$(session_prop "$sid" Class)
    type=$(session_prop "$sid" Type)
    state=$(session_prop "$sid" State)
    remote=$(session_prop "$sid" Remote)
    active=$(session_prop "$sid" Active)

    [ -n "$uid" ] || continue
    [ "$uid" != "0" ] || continue
    [ "$name" != "gdm-greeter" ] || continue
    [ "$class" = "user" ] || continue
    [ "$remote" != "yes" ] || continue
    case "$type" in wayland|x11) ;; *) continue ;; esac
    case "$state" in active|online) ;; *) continue ;; esac
    [ "$active" != "no" ] || continue
    printf '%s\n' "$uid"
    return 0
  done < <(loginctl list-sessions --no-legend 2>/dev/null)

  # The user session can become inactive when GDM takes the foreground VT.
  # Continue watching any local non-greeter user that still owns gnome-shell.
  while read -r sid _; do
    [ -n "$sid" ] || continue
    uid=$(session_prop "$sid" User)
    name=$(session_prop "$sid" Name)
    [ -n "$uid" ] || continue
    [ "$uid" != "0" ] || continue
    [ "$name" != "gdm-greeter" ] || continue
    user=$(id -nu "$uid" 2>/dev/null) || continue
    if pgrep -u "$user" -x gnome-shell >/dev/null 2>&1; then
      printf '%s\n' "$uid"
      return 0
    fi
  done < <(loginctl list-sessions --no-legend 2>/dev/null)

  return 1
}

get_gnome_pid() {
  local uid="$1" user
  user=$(id -nu "$uid" 2>/dev/null) || return 1
  pgrep -u "$user" -x gnome-shell 2>/dev/null | head -1
}

pid_is_gnome_shell_for_uid() {
  local pid="$1" expected_uid="$2" actual_uid comm
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  [ -d "/proc/$pid" ] || return 1
  read -r comm < "/proc/$pid/comm" 2>/dev/null || return 1
  actual_uid=$(awk '/^Uid:/ { print $2; exit }' "/proc/$pid/status" 2>/dev/null)
  [ "$comm" = "gnome-shell" ] && [ "$actual_uid" = "$expected_uid" ]
}

# org.gnome.Shell.Eval is implemented by Shell's JavaScript D-Bus object, so a
# reply proves that the compositor's main context dispatched the call. Eval is
# disabled in hardened production sessions and normally returns false; that is
# still a successful health response. The expression itself has no side effect
# if evaluation is enabled.
probe_gnome_shell_main_loop() {
  local uid="$1" user
  user=$(id -nu "$uid" 2>/dev/null) || return 1
  runuser -u "$user" -- env \
    XDG_RUNTIME_DIR="/run/user/${uid}" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${uid}/bus" \
    timeout "$PROBE_TIMEOUT_SECONDS" dbus-send --session \
      --dest=org.gnome.Shell \
      --print-reply \
      /org/gnome/Shell \
      org.gnome.Shell.Eval \
      string:true \
    >/dev/null 2>&1
}

print_proc_file() {
  local path="$1"
  if [ -r "$path" ]; then
    cat "$path" 2>/dev/null || printf '(read failed)\n'
  else
    printf '(unavailable)\n'
  fi
}

# ── system-wide starvation detection ───────────────────────────────────────
#
# A failed health probe only proves that no reply arrived within the timeout.
# That happens both when the compositor's main loop is wedged and when the
# machine is too contended to schedule the probe itself. The two need opposite
# responses: killing GNOME Shell recovers the first and merely destroys a
# working session during the second, so classify before acting.

# Pressure Stall Information, as an integer percentage of the last 10 seconds.
# $1 = cpu|io|memory, $2 = some|full. Prints 0 when PSI is unavailable.
psi_avg10() {
  local kind="$2" path="/proc/pressure/$1" value=""

  if [ -r "$path" ]; then
    # Lines read: "some avg10=0.00 avg60=0.00 avg300=0.00 total=0".
    # Truncate rather than round, so a threshold of N means "at least N".
    value=$(awk -v kind="$kind" '
      $1 == kind {
        for (i = 2; i <= NF; i++) {
          if (index($i, "avg10=") == 1) {
            split($i, kv, "=")
            printf "%d", kv[2] + 0
            exit
          }
        }
      }' "$path" 2>/dev/null)
  fi

  case "${value:-}" in
    ''|*[!0-9]*) printf '0\n' ;;
    *) printf '%s\n' "$value" ;;
  esac
}

# Wall time of a single fork+exec, in milliseconds. This measures the exact
# thing that collapsed during the 2026-08-26 incident: process creation on a
# saturated machine. It is also the cheapest honest probe available -- two
# forks -- and unlike PSI it reflects slab, I/O and lock contention too.
spawn_latency_ms() {
  local i start end a b c m
  # Median of three, not a single sample: one scheduling outlier must not be
  # able to declare the machine starved on its own, and one lucky sample must
  # not mask sustained contention. Sorted inline because forking sort(1) here
  # would perturb the very thing being measured.
  for i in 0 1 2; do
    start=${EPOCHREALTIME/./}
    /usr/bin/true 2>/dev/null
    end=${EPOCHREALTIME/./}
    case "$start$end" in
      *[!0-9]*) printf '0\n'; return 0 ;;
    esac
    m=$(( (end - start) / 1000 ))
    case "$i" in 0) a=$m ;; 1) b=$m ;; 2) c=$m ;; esac
  done
  if [ "$a" -gt "$b" ]; then m=$a; a=$b; b=$m; fi
  if [ "$b" -gt "$c" ]; then b=$c; fi
  if [ "$a" -gt "$b" ]; then b=$a; fi
  printf '%d\n' "$b"
}

# Prints "starved" or "responsive", followed by the evidence that decided it.
classify_system_load() {
  local latency cpu_some io_full mem_full verdict=responsive reason=""

  latency=$(spawn_latency_ms)
  cpu_some=$(psi_avg10 cpu some)
  io_full=$(psi_avg10 io full)
  mem_full=$(psi_avg10 memory full)

  if [ "$latency" -ge "$SPAWN_LATENCY_THRESHOLD_MS" ]; then
    verdict=starved
    reason="fork+exec took ${latency}ms (threshold ${SPAWN_LATENCY_THRESHOLD_MS}ms)"
  elif [ "$cpu_some" -ge "$PSI_CPU_SOME_THRESHOLD" ]; then
    verdict=starved
    reason="cpu pressure some avg10=${cpu_some}% (threshold ${PSI_CPU_SOME_THRESHOLD}%)"
  elif [ "$io_full" -ge "$PSI_IO_FULL_THRESHOLD" ]; then
    verdict=starved
    reason="io pressure full avg10=${io_full}% (threshold ${PSI_IO_FULL_THRESHOLD}%)"
  elif [ "$mem_full" -ge "$PSI_MEM_FULL_THRESHOLD" ]; then
    verdict=starved
    reason="memory pressure full avg10=${mem_full}% (threshold ${PSI_MEM_FULL_THRESHOLD}%)"
  else
    reason="spawn=${latency}ms cpu_some=${cpu_some}% io_full=${io_full}% mem_full=${mem_full}%"
  fi

  printf '%s %s\n' "$verdict" "$reason"
}

collect_thread_state() {
  local pid="$1" detail="${2:-standard}" task tid comm fd target

  echo "--- gnome-shell threads ---"
  ps -L -p "$pid" -o pid,tid,psr,stat,wchan:40,pcpu,comm 2>&1 || true

  for task in "/proc/$pid"/task/[0-9]*; do
    [ -d "$task" ] || continue
    tid=${task##*/}
    comm=$(cat "$task/comm" 2>/dev/null || printf unknown)
    echo "[thread tid=$tid comm=$comm]"
    # wchan has no trailing newline; without one the syscall line runs into it.
    printf 'wchan: %s\n' "$(cat "$task/wchan" 2>/dev/null || printf '(read failed)')"
    printf 'syscall: '
    print_proc_file "$task/syscall"
    echo "kernel stack:"
    print_proc_file "$task/stack"
  done

  echo "--- gnome-shell DRM file descriptors ---"
  for fd in "/proc/$pid"/fd/[0-9]*; do
    [ -e "$fd" ] || continue
    target=$(readlink "$fd" 2>/dev/null || true)
    case "$target" in /dev/dri/*)
      echo "[fd=${fd##*/} target=$target]"
      print_proc_file "/proc/$pid/fdinfo/${fd##*/}"
      ;;
    esac
  done

  echo "--- gnome-shell memory map ---"
  print_proc_file "/proc/$pid/maps"

  # eu-stack is the only expensive part of this function -- it stops the target
  # to unwind it -- so it is the only part gated on full detail. wchan, syscall
  # and the kernel stacks are plain /proc reads and identify where the main loop
  # is blocked, which is exactly what a hang that self-resolves needs recorded.
  if [ "$detail" != "full" ]; then
    return 0
  fi
  echo "--- gnome-shell userspace stacks (eu-stack, 15s limit) ---"
  if command -v eu-stack >/dev/null 2>&1; then
    timeout -k 2s 15s eu-stack -p "$pid" 2>&1 || echo "(eu-stack failed or timed out)"
  else
    echo "(eu-stack unavailable)"
  fi
}

collect_drm_state() {
  local card connector field

  echo "--- drm devices ---"
  ls -l /dev/dri /dev/dri/by-path 2>/dev/null || true
  for card in /sys/class/drm/card[0-9]*; do
    [ -r "$card/device/vendor" ] || continue
    echo "[$card]"
    for field in \
      device/vendor \
      device/device \
      device/power/control \
      device/power/runtime_status \
      device/power/runtime_suspended_time \
      device/d3cold_allowed; do
      if [ -r "$card/$field" ]; then
        printf '%s=' "$field"
        cat "$card/$field" 2>/dev/null || true
      fi
    done
  done

  echo "--- drm connectors ---"
  for connector in /sys/class/drm/card[0-9]*-*; do
    [ -r "$connector/status" ] || continue
    printf '%s status=' "$connector"
    cat "$connector/status" 2>/dev/null || true
    if [ -r "$connector/enabled" ]; then
      printf '%s enabled=' "$connector"
      cat "$connector/enabled" 2>/dev/null || true
    fi
  done

  echo "--- NVIDIA state (5s limit) ---"
  if command -v nvidia-smi >/dev/null 2>&1; then
    timeout -k 2s 5s nvidia-smi \
      --query-gpu=pci.bus_id,pstate,power.draw,memory.used,display_active,display_mode \
      --format=csv,noheader 2>&1 || echo "(nvidia-smi failed or timed out)"
  else
    echo "(nvidia-smi unavailable)"
  fi

  echo "--- DRM debugfs clients and atomic state (bounded) ---"
  for field in /sys/kernel/debug/dri/[0-9]*/clients /sys/kernel/debug/dri/[0-9]*/state; do
    [ -r "$field" ] || continue
    echo "[$field]"
    timeout -k 1s 3s head -n 1000 "$field" 2>&1 || echo "(read failed or timed out)"
  done
}

collect_drm_clients() {
  local proc pid client_fd detail_fd fd_number target key comm uid context
  local deadline=$((SECONDS + 20)) scanned=0
  declare -A seen=()

  # This walks every process and readlinks every descriptor. On a machine that
  # is spawning thousands of processes a second -- the exact situation that
  # produces a hang worth diagnosing -- an unbounded walk never terminates.
  echo "--- processes with open DRM devices (bounded: 20s / 4000 processes) ---"
  for proc in /proc/[0-9]*; do
    [ -d "$proc/fd" ] || continue
    scanned=$((scanned + 1))
    if [ "$scanned" -gt 4000 ] || [ "$SECONDS" -ge "$deadline" ]; then
      echo "(scan truncated after $scanned processes)"
      break
    fi
    pid=${proc##*/}
    for client_fd in "$proc"/fd/[0-9]*; do
      [ -e "$client_fd" ] || continue
      target=$(readlink "$client_fd" 2>/dev/null || true)
      case "$target" in /dev/dri/*) ;; *) continue ;; esac

      key="$pid:$target"
      [ -z "${seen[$key]:-}" ] || continue
      seen[$key]=1
      comm=$(cat "$proc/comm" 2>/dev/null || printf unknown)
      uid=$(awk '/^Uid:/ { print $2; exit }' "$proc/status" 2>/dev/null)
      context=$(cat "$proc/attr/current" 2>/dev/null || printf unavailable)
      echo "[pid=$pid uid=${uid:-unknown} comm=$comm device=$target context=$context]"

      # Record every fdinfo entry for this process/device pair. DRM fdinfo
      # carries the driver, client ID, engine, and memory accounting data.
      for detail_fd in "$proc"/fd/[0-9]*; do
        [ -e "$detail_fd" ] || continue
        [ "$(readlink "$detail_fd" 2>/dev/null || true)" = "$target" ] || continue
        fd_number=${detail_fd##*/}
        echo "[pid=$pid fd=$fd_number]"
        print_proc_file "$proc/fdinfo/$fd_number"
      done
    done
  done
}

# Snapshot for the "the whole machine is starved" case. Deliberately disjoint
# from collect_state: what matters here is who is consuming the machine, not
# what GNOME Shell's threads are doing.
collect_starvation_state() {
  local label="$1" reason="${2:-}" lookback="${3:-180}"
  local forks_before forks_after since resource slice base

  since=$(seconds_ago "$lookback")

  {
    echo "=== $label at $(date -Iseconds) ==="
    echo "verdict: system-wide resource starvation"
    echo "evidence: ${reason:-none}"
    echo "boot_id: $(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)"
    echo "uptime: $(cat /proc/uptime 2>/dev/null || true)"
    echo "loadavg: $(cat /proc/loadavg 2>/dev/null || true)"
    echo "spawn_latency_ms: $(spawn_latency_ms)"

    echo "--- pressure stall information ---"
    for resource in cpu io memory irq; do
      printf '[%s]\n' "$resource"
      print_proc_file "/proc/pressure/$resource"
    done

    # Process creation rate. This is the signal that identified the 2026-08-26
    # incident: ~20000 processes in 150 seconds from an editor's git integration.
    forks_before=$(awk '/^processes / { print $2; exit }' /proc/stat 2>/dev/null || echo 0)
    sleep 2
    forks_after=$(awk '/^processes / { print $2; exit }' /proc/stat 2>/dev/null || echo 0)
    echo "--- process creation rate ---"
    echo "forks_per_second: $(( (forks_after - forks_before) / 2 ))"
    echo "procs_running_blocked: $(awk '/^procs_running|^procs_blocked/ { printf "%s=%s ", $1, $2 }' /proc/stat 2>/dev/null)"

    echo "--- memory ---"
    head -n 8 /proc/meminfo 2>/dev/null || true
    echo "swap: $(swapon --show=NAME,USED --noheadings 2>/dev/null | tr '\n' ' ')"

    echo "--- top control groups by CPU (5s limit) ---"
    timeout -k 2s 5s systemd-cgtop --batch --iterations=2 --delay=1s \
      --order=cpu --depth=4 2>/dev/null | tail -n 30 || echo "(systemd-cgtop failed or timed out)"

    echo "--- top processes by CPU ---"
    timeout -k 2s 5s ps -eo pid,ppid,uid,ni,pcpu,pmem,rss,stat,wchan:24,comm \
      --sort=-pcpu 2>/dev/null | head -n 25 || echo "(ps failed or timed out)"

    echo "--- top processes by RSS ---"
    timeout -k 2s 5s ps -eo pid,ppid,uid,pcpu,pmem,rss,stat,comm \
      --sort=-rss 2>/dev/null | head -n 15 || echo "(ps failed or timed out)"

    echo "--- tasks in uninterruptible sleep ---"
    timeout -k 2s 5s ps -eo pid,stat,wchan:32,comm 2>/dev/null \
      | awk 'NR == 1 || $2 ~ /D/' | head -n 25 || echo "(ps failed or timed out)"

    echo "--- session vs application slice accounting ---"
    for slice in session.slice app.slice background.slice; do
      for base in /sys/fs/cgroup/user.slice/user-*.slice/user@*.service; do
        [ -d "$base/$slice" ] || continue
        printf '[%s/%s]\n' "${base##*/}" "$slice"
        printf 'cpu.weight='
        print_proc_file "$base/$slice/cpu.weight"
        printf 'io.weight='
        print_proc_file "$base/$slice/io.weight"
        echo "cpu.stat:"
        head -n 3 "$base/$slice/cpu.stat" 2>/dev/null || echo "(unavailable)"
        echo "cpu.pressure:"
        print_proc_file "$base/$slice/cpu.pressure"
      done
    done

    echo "--- recent kernel warnings ---"
    timeout -k 2s 10s journalctl -b -k --since "$since" -p warning..alert --no-pager 2>/dev/null || true
  } | systemd-cat -t "$TAG" -p warning
}

# Run a snapshot detached from the check loop and under a hard time bound.
#
# The previous implementation called collect_state synchronously before the
# failure-limit check, so on a starved machine a single collection could take
# minutes and push recovery far past the intended FAILURE_LIMIT * interval.
# Only one snapshot may be in flight; a second request is dropped rather than
# queued, because the machine is already short of resources.
SNAPSHOT_PID=""

snapshot_in_flight() {
  [ -n "$SNAPSHOT_PID" ] || return 1
  if kill -0 "$SNAPSHOT_PID" 2>/dev/null; then
    return 0
  fi
  wait "$SNAPSHOT_PID" 2>/dev/null || true
  SNAPSHOT_PID=""
  return 1
}

# The check loop needs Nice=-15 to be scheduled during the very event it
# watches for. The collector does not: it runs ps, journalctl, systemd-cgtop and
# a /proc walk, and inherits that priority from the service cgroup. Renice it
# back down so diagnostics never outbid the compositor they exist to protect.
# This reorders competition inside the service's cgroup, which is where the
# collector's cost actually lands; the cgroup's own CPUWeight still applies.
snapshot_nice_prefix() {
  # nice(1) is relative to the caller, so from -15 this clamps to +19.
  if ionice -c 3 true 2>/dev/null; then
    printf '%s\n' nice -n 34 ionice -c 3
  else
    printf '%s\n' nice -n 34
  fi
}

run_snapshot_detached() {
  local preempt=no nice_prefix
  local budget="$SNAPSHOT_TIMEOUT_SECONDS" grace="$SNAPSHOT_KILL_GRACE_SECONDS"
  if [ "${1:-}" = "--preempt" ]; then
    preempt=yes
    budget="$FULL_SNAPSHOT_TIMEOUT_SECONDS"
    grace="$FULL_SNAPSHOT_KILL_GRACE_SECONDS"
    shift
  fi
  if snapshot_in_flight; then
    if [ "$preempt" != yes ]; then
      log_warn "monitor: snapshot $SNAPSHOT_PID still running; skipping this collection"
      return 0
    fi
    # The pre-recovery snapshot is the last chance to capture this compositor
    # before it is signalled, so it displaces a routine collection rather than
    # being dropped by the in-flight guard.
    log_warn "monitor: pre-empting in-flight snapshot $SNAPSHOT_PID for the pre-recovery collection"
    kill -TERM "$SNAPSHOT_PID" 2>/dev/null || true
    wait "$SNAPSHOT_PID" 2>/dev/null || true
    SNAPSHOT_PID=""
  fi
  mapfile -t nice_prefix < <(snapshot_nice_prefix)
  "${nice_prefix[@]}" timeout -k "${grace}s" "${budget}s" "$SELF" "$@" &
  SNAPSHOT_PID=$!
}

collect_state() {
  local label="$1" uid="${2:-}" pid="${3:-}" lookback="${4:-120}" detail="${5:-standard}"
  local user="" since

  since=$(seconds_ago "$lookback")
  [ -z "$uid" ] || user=$(id -nu "$uid" 2>/dev/null || true)

  {
    echo "=== $label at $(date -Iseconds) ==="
    echo "boot_id: $(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)"
    echo "uptime: $(cat /proc/uptime 2>/dev/null || true)"
    echo "kernel_cmdline: $(cat /proc/cmdline 2>/dev/null || true)"
    echo "mem_sleep: $(cat /sys/power/mem_sleep 2>/dev/null || true)"
    echo "core_pattern: $(cat /proc/sys/kernel/core_pattern 2>/dev/null || true)"
    echo "uid: ${uid:-none}"
    echo "user: ${user:-none}"
    echo "gnome_pid: ${pid:-none}"
    # Compositor state first. Everything below it can block for seconds on a
    # starved machine (systemd-inhibit and the runuser round-trip each have a
    # 5s timeout that routinely elapses), and the pre-recovery snapshot only has
    # a two-second head start before SIGTERM lands -- so anything ordered after
    # that preamble would capture a process already tearing down, not a hung one.
    if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
      echo "--- gnome-shell process status ---"
      print_proc_file "/proc/$pid/status"
      echo "--- gnome-shell limits ---"
      print_proc_file "/proc/$pid/limits"
      collect_thread_state "$pid" "$detail"
    fi

    echo "--- login sessions ---"
    loginctl list-sessions --no-legend 2>/dev/null || true
    echo "--- inhibitors ---"
    timeout 5 systemd-inhibit --list --no-pager 2>/dev/null || true

    if [ -n "$user" ]; then
      echo "--- gnome-shell user service ---"
      timeout 5 runuser -u "$user" -- env \
        XDG_RUNTIME_DIR="/run/user/${uid}" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${uid}/bus" \
        systemctl --user show org.gnome.Shell@user.service \
          -p ActiveState -p SubState -p MainPID -p Result \
          -p ExecMainCode -p ExecMainStatus -p LimitCORE \
        2>/dev/null || true
    fi

    collect_drm_state
    if [ "$detail" = "full" ]; then
      collect_drm_clients
    fi
    # Bounded: journalctl can block for a long time on a contended disk, and
    # these run last, inside the outer snapshot timeout.
    echo "--- recent display, sleep, and SELinux events ---"
    timeout -k 2s 10s journalctl -b --since "$since" --no-pager -n 240 \
      --grep='drmModeAtomicCommit|NVRM: Xid|i915.*(hang|reset)|PrepareForSleep|PM: suspend|PM: resume|USER_AVC|avc:.*denied' \
      2>/dev/null || true
    echo "--- recent kernel warnings ---"
    timeout -k 2s 10s journalctl -b -k --since "$since" -p warning..alert --no-pager 2>/dev/null || true
    if [ -n "$uid" ]; then
      echo "--- recent user journal ---"
      timeout -k 2s 10s journalctl -b --since "$since" _UID="$uid" --no-pager -n 120 2>/dev/null || true
    fi
  } | systemd-cat -t "$TAG" -p warning
}

recovery_enabled() {
  [ "$RECOVER_HUNG_SHELL" = "yes" ] && [ ! -e "$RECOVERY_DISABLE_FILE" ]
}

# Returns 0 only when the signal was actually sent, so callers never act on a
# SIGTERM that did not happen.
recover_shell() {
  local uid="$1" expected_pid="$2" live_pid

  live_pid=$(get_gnome_pid "$uid" 2>/dev/null || true)
  if [ "$live_pid" != "$expected_pid" ] || ! pid_is_gnome_shell_for_uid "$live_pid" "$uid"; then
    log_warn "monitor: recovery skipped; tracked gnome-shell PID $expected_pid is no longer current"
    return 1
  fi

  if ! recovery_enabled; then
    log_err "monitor: recovery disabled; leaving hung gnome-shell PID $live_pid running"
    return 1
  fi

  log_err "monitor: $FAILURE_LIMIT consecutive health failures; sending SIGCONT+SIGTERM to gnome-shell PID $live_pid"
  kill -CONT "$live_pid" 2>/dev/null || true
  sleep 0.1
  kill -TERM "$live_pid" 2>/dev/null || true
}

# ── kernel-side wedges ─────────────────────────────────────────────────────
#
# SIGTERM only recovers a shell whose main loop is stuck in userspace. When a
# thread is in uninterruptible sleep inside a driver, the signal stays pending
# until the driver call returns. On 2026-09-21 gnome-shell's KMS thread blocked
# in nvkms_ioctl_from_kapi_try_pmlock when gsd-power blanked an NVIDIA-driven
# display under the lock screen. Three SIGTERMs changed nothing, and the machine
# needed a hard power-off. See docs/nvidia-dpms-lock-hang.md.

# A wait channel counts as "inside the NVIDIA driver" when the symbol belongs
# to one of the nvidia* modules (nvidia, nvidia_modeset, nvidia_drm,
# nvidia_uvm), by ownership rather than
# by name prefix: the driver's actual lock and wait primitives are os_acquire_*,
# os_wait_*, rm_* and friends, and a name prefix such as nv_* also matches
# amdgpu. Names that also exist outside those modules are excluded, since a
# wchan is a bare name and cannot say which copy it is.
#
# The monitor's sandbox masks /proc/kallsyms (ProtectKernelTunables=yes), so the
# unit builds this list with a privileged ExecStartPre=+ before the sandbox
# applies. Without the list, NVIDIA detection is off: a false match ends in a
# reboot, while a miss only leaves today's behaviour.
NVIDIA_SYMBOLS_FILE=$RUNDIR/nvidia-wchan-symbols
declare -A NVIDIA_SYMBOLS=()
NVIDIA_SYMBOLS_LOADED=no

write_nvidia_symbols() {
  local tmp
  mkdir -p "$RUNDIR"
  tmp=$(mktemp "$RUNDIR/.nvidia-wchan-symbols.XXXXXX") || return 1
  awk '$2 ~ /^[tT]$/ {
         if ($4 ~ /^\[nvidia/) nv[$3] = 1
         else other[$3] = 1
       }
       END { for (s in nv) if (!(s in other)) print s }' /proc/kallsyms > "$tmp" &&
    mv -f "$tmp" "$NVIDIA_SYMBOLS_FILE" || { rm -f "$tmp"; return 1; }
}

load_nvidia_symbols() {
  local symbol
  [ "$NVIDIA_SYMBOLS_LOADED" = "no" ] || return 0
  NVIDIA_SYMBOLS_LOADED=missing
  [ -s "$NVIDIA_SYMBOLS_FILE" ] || return 1
  while read -r symbol; do
    NVIDIA_SYMBOLS[$symbol]=1
  done < "$NVIDIA_SYMBOLS_FILE"
  NVIDIA_SYMBOLS_LOADED=yes
}

is_nvidia_wchan() {
  load_nvidia_symbols || return 1
  [ -n "$1" ] && [ -n "${NVIDIA_SYMBOLS[$1]:-}" ]
}

# Print "tid wchan comm" for every thread of $1 in uninterruptible sleep. One
# ps call rather than a read per thread: under this image's kargs every fork
# costs ~3 ms, and this runs while the machine is already in trouble.
blocked_threads() {
  local tid stat wchan comm
  while read -r tid stat wchan comm; do
    case "$stat" in D*) ;; *) continue ;; esac
    printf '%s %s %s\n' "$tid" "${wchan:--}" "${comm:-unknown}"
  done < <(ps -L -p "$1" -o tid=,stat=,wchan:64=,comm= 2>/dev/null)
}

# Filter blocked_threads output ($1) down to threads inside the NVIDIA driver.
nvidia_wedged_threads() {
  local tid wchan comm
  while read -r tid wchan comm; do
    [ -n "$tid" ] || continue
    if is_nvidia_wchan "$wchan"; then
      printf '%s %s %s\n' "$tid" "$wchan" "$comm"
    fi
  done <<< "$1"
}

# One line per thread for log messages.
join_lines() {
  local text="${1%$'\n'}"
  printf '%s' "${text//$'\n'/; }"
}

# Ask the kernel for the stacks of every blocked task (sysrq-w) and a backtrace
# of every CPU (sysrq-l). The compositor's own kernel stacks are unreadable
# here (/proc/<pid>/stack needs CAP_SYS_ADMIN), and the task that holds the
# lock is usually not the compositor anyway. Synchronous, so the stacks are
# taken before SIGTERM starts tearing the shell down. Once per compositor PID;
# a failed attempt is retried on the next recovery cycle.
DUMPED_BLOCKED_PID=""

dump_blocked_tasks() {
  local pid="$1" blocked="$2"
  [ "$DUMPED_BLOCKED_PID" != "$pid" ] || return 0
  log_warn "monitor: gnome-shell PID $pid has thread(s) in uninterruptible sleep: $(join_lines "$blocked"); requesting a sysrq blocked-task and CPU backtrace dump into the kernel log"
  if timeout -k 2s 10s systemctl start "$BLOCKED_TASKS_DUMP_UNIT" >/dev/null 2>&1; then
    DUMPED_BLOCKED_PID="$pid"
  else
    log_warn "monitor: $BLOCKED_TASKS_DUMP_UNIT did not complete within 10s; blocked-task stacks may be missing"
  fi
}

# Still wedged: the PID is the same gnome-shell and at least one thread is in D
# inside the NVIDIA driver. Prints the wedged threads.
still_wedged() {
  local uid="$1" pid="$2" wedged
  pid_is_gnome_shell_for_uid "$pid" "$uid" || return 1
  wedged=$(nvidia_wedged_threads "$(blocked_threads "$pid")")
  [ -n "$wedged" ] || return 1
  printf '%s\n' "$wedged"
}

# Runs only after recover_shell actually sent SIGTERM. $3 is the blocked-thread
# scan taken just before the signal. Returns at once unless a thread was inside
# the NVIDIA driver. Otherwise: SIGKILL after DRIVER_WEDGE_KILL_AFTER_SECONDS
# (TASK_KILLABLE waits also show as D, and killing one process is far cheaper
# than a reboot; the session is lost either way), then reboot if the thread is
# still stuck after DRIVER_WEDGE_GRACE_SECONDS. Blocking the check loop is fine:
# nothing it could do in the meantime would reach this compositor.
handle_driver_wedge() {
  local uid="$1" pid="$2" wedged waited=0 killed=no
  wedged=$(nvidia_wedged_threads "$3")
  [ -n "$wedged" ] || return 0

  log_err "monitor: gnome-shell PID $pid is blocked inside the NVIDIA driver ($(join_lines "$wedged")); a pending SIGTERM cannot land until that call returns; waiting up to ${DRIVER_WEDGE_GRACE_SECONDS}s"

  while [ "$waited" -lt "$DRIVER_WEDGE_GRACE_SECONDS" ]; do
    sleep 5
    waited=$((waited + 5))
    if [ -e "$SLEEP_MARKER" ]; then
      log_info "monitor: driver-wedge handling cancelled because system sleep began"
      return 0
    fi
    if ! wedged=$(still_wedged "$uid" "$pid"); then
      log_info "monitor: gnome-shell PID $pid is no longer blocked inside the NVIDIA driver after ${waited}s; leaving recovery to the pending signal"
      return 0
    fi
    if [ "$killed" = no ] && [ "$waited" -ge "$DRIVER_WEDGE_KILL_AFTER_SECONDS" ] &&
       [ "$DRIVER_WEDGE_ACTION" = "reboot" ] && recovery_enabled; then
      log_err "monitor: gnome-shell PID $pid ignored SIGTERM for ${waited}s; sending SIGKILL"
      kill -KILL "$pid" 2>/dev/null || true
      killed=yes
    fi
  done

  # The opt-outs are re-read: a diagnostic run that keeps the hung shell for
  # inspection must not end in a reboot either.
  if [ "$DRIVER_WEDGE_ACTION" != "reboot" ] || ! recovery_enabled; then
    log_err "monitor: gnome-shell PID $pid still blocked inside the NVIDIA driver after ${waited}s ($(join_lines "$wedged")); automatic reboot disabled; only a reboot will release the display"
    return 0
  fi

  # No explicit sync: sync(2) sleeps uninterruptibly on a stuck mount, and
  # timeout(1) waits for its child even after SIGKILL, so it could hold the
  # reboot back forever. The orderly reboot below flushes and unmounts
  # everything, and systemd-shutdown bounds its own final sync. Not reboot -f,
  # so the journal, and with it this incident's evidence, is flushed to disk.
  log_err "monitor: gnome-shell PID $pid still blocked inside the NVIDIA driver after ${waited}s ($(join_lines "$wedged")); rebooting"
  if ! timeout -k 5s 30s systemctl reboot >/dev/null 2>&1; then
    log_err "monitor: systemctl reboot failed; the machine needs a manual reboot"
  fi
}

# Sleep until the next tick boundary rather than for a fixed duration, so the
# time spent probing can never stretch the interval between health checks.
wait_for_next_tick() {
  local deadline="$1" now remaining
  now=$(date +%s 2>/dev/null) || now=0
  remaining=$((deadline - now))
  # Always yield the CPU. A tick that overran its own interval would otherwise
  # sleep zero and spin at Nice=-15/CPUWeight=10000, actively worsening the
  # starvation it exists to detect. The upper clamp catches a failed date(1),
  # which would otherwise compute a sleep of ~1.8 billion seconds.
  if [ "$remaining" -lt "$MIN_TICK_SLEEP_SECONDS" ] ||
     [ "$remaining" -gt "$CHECK_INTERVAL_SECONDS" ]; then
    remaining=$MIN_TICK_SLEEP_SECONDS
  fi
  sleep "$remaining"
}

monitor_loop() {
  local uid pid tracked_pid="" failures=0 starved_ticks=0
  local verdict reason classification detail deadline blocked

  mkdir -p "$RUNDIR"
  log_info "monitor: started (interval=${CHECK_INTERVAL_SECONDS}s timeout=${PROBE_TIMEOUT_SECONDS}s failures=${FAILURE_LIMIT} recovery=${RECOVER_HUNG_SHELL} snapshot_timeout=${SNAPSHOT_TIMEOUT_SECONDS}s wedge_action=${DRIVER_WEDGE_ACTION} wedge_kill_after=${DRIVER_WEDGE_KILL_AFTER_SECONDS}s wedge_grace=${DRIVER_WEDGE_GRACE_SECONDS}s)"
  if load_nvidia_symbols; then
    log_info "monitor: NVIDIA driver-wedge detection armed (${#NVIDIA_SYMBOLS[@]} symbols)"
  else
    log_warn "monitor: $NVIDIA_SYMBOLS_FILE missing or empty; NVIDIA driver-wedge detection is off"
  fi
  trap 'log_info "monitor: stopped"; exit 0' TERM INT

  while true; do
    deadline=$(( $(date +%s 2>/dev/null || echo 0) + CHECK_INTERVAL_SECONDS ))

    if [ -e "$SLEEP_MARKER" ]; then
      failures=0
      starved_ticks=0
      wait_for_next_tick "$deadline"
      continue
    fi

    uid=$(get_active_uid 2>/dev/null || true)
    pid=""
    [ -z "$uid" ] || pid=$(get_gnome_pid "$uid" 2>/dev/null || true)

    if [ -z "$uid" ] || ! pid_is_gnome_shell_for_uid "$pid" "$uid"; then
      if [ -n "$tracked_pid" ]; then
        log_info "monitor: gnome-shell PID $tracked_pid is no longer present; waiting for a user session"
      fi
      tracked_pid=""
      failures=0
      starved_ticks=0
      wait_for_next_tick "$deadline"
      continue
    fi

    if [ "$pid" != "$tracked_pid" ]; then
      tracked_pid="$pid"
      failures=0
      starved_ticks=0
      log_info "monitor: tracking gnome-shell PID $pid for UID $uid"
      # Allow a newly started shell to acquire its D-Bus name before probing.
      wait_for_next_tick "$deadline"
      continue
    fi

    if probe_gnome_shell_main_loop "$uid"; then
      if [ "$failures" -gt 0 ] || [ "$starved_ticks" -gt 0 ]; then
        log_info "monitor: gnome-shell PID $pid responded again after $failures shell failure(s) and $starved_ticks starved tick(s)"
      fi
      failures=0
      starved_ticks=0
      wait_for_next_tick "$deadline"
      continue
    fi

    # systemd freezes the user slice before invoking system-sleep hooks. A probe
    # already in flight can therefore time out after suspend has begun. Do not
    # count or diagnose that expected failure once the hook's marker is visible.
    if [ -e "$SLEEP_MARKER" ]; then
      if [ "$failures" -gt 0 ]; then
        log_info "monitor: discarding pending health failures because system sleep began"
      fi
      failures=0
      starved_ticks=0
      wait_for_next_tick "$deadline"
      continue
    fi

    # A silent compositor and a machine too loaded to schedule the probe look
    # identical from here. Only one of them is fixed by killing GNOME Shell.
    classification=$(classify_system_load)
    verdict=${classification%% *}
    reason=${classification#* }

    if [ "$verdict" = "starved" ]; then
      starved_ticks=$((starved_ticks + 1))
      # Never escalate to recovery: the compositor is a victim here, not the
      # cause, and restarting it would destroy a working session without
      # returning any CPU or I/O to the machine.
      #
      # Hold the failure count rather than clearing it. Zeroing would mean that
      # on an intermittently loaded machine -- ticks alternating starved and
      # responsive -- a genuinely wedged shell could never reach FAILURE_LIMIT,
      # and the user would still be left hard-resetting. A starved tick simply
      # does not count; it does not forgive the ticks that did.
      log_warn "monitor: health probe failed under system-wide resource starvation (tick $starved_ticks); $reason; not treating this as a shell hang"
      # Snapshot the first tick, then every fourth, so a long overload logs
      # progress without piling collections onto an already starved machine.
      if [ "$starved_ticks" -eq 1 ] || [ $((starved_ticks % 4)) -eq 0 ]; then
        run_snapshot_detached starvation-snapshot \
          "system starvation while gnome-shell PID $pid was unreachable (tick $starved_ticks)" \
          "$reason" 180
      fi
      wait_for_next_tick "$deadline"
      continue
    fi

    if [ "$starved_ticks" -gt 0 ]; then
      log_info "monitor: system load recovered after $starved_ticks starved tick(s); resuming shell-hang accounting"
      starved_ticks=0
    fi

    failures=$((failures + 1))
    log_warn "monitor: gnome-shell PID $pid unresponsive (attempt $failures/$FAILURE_LIMIT); system responsive ($reason)"

    # Collect the cheap snapshot on the way up and the expensive one only on the
    # attempt that triggers recovery, where it is the last chance to capture the
    # compositor's threads before it is signalled.
    if [ "$failures" -ge "$FAILURE_LIMIT" ]; then
      detail=full
    else
      detail=standard
    fi
    if [ "$detail" = full ]; then
      run_snapshot_detached --preempt snapshot \
        "gnome-shell unresponsive attempt $failures/$FAILURE_LIMIT" \
        "$uid" "$pid" 180 "$detail"
    else
      run_snapshot_detached snapshot \
        "gnome-shell unresponsive attempt $failures/$FAILURE_LIMIT" \
        "$uid" "$pid" 180 "$detail"
    fi

    if [ "$failures" -ge "$FAILURE_LIMIT" ]; then
      # Give the final snapshot a brief head start so the thread state is
      # captured before the signal lands, but never wait on it.
      sleep 2
      if [ -e "$SLEEP_MARKER" ]; then
        log_info "monitor: recovery cancelled because system sleep began"
      else
        # Before signalling: this is evidence about the hang, not about the
        # teardown that SIGTERM starts.
        blocked=$(blocked_threads "$pid")
        [ -z "$blocked" ] || dump_blocked_tasks "$pid" "$blocked"
        if recover_shell "$uid" "$pid"; then
          handle_driver_wedge "$uid" "$pid" "$blocked"
        fi
      fi
      tracked_pid=""
      failures=0
    fi

    wait_for_next_tick "$deadline"
  done
}

case "${1:-monitor}" in
  monitor)
    monitor_loop
    ;;
  active-uid)
    get_active_uid
    ;;
  gnome-pid)
    get_gnome_pid "${2:?UID required}"
    ;;
  probe)
    probe_gnome_shell_main_loop "${2:?UID required}"
    ;;
  snapshot)
    collect_state \
      "${2:?label required}" \
      "${3:-}" \
      "${4:-}" \
      "${5:-120}" \
      "${6:-standard}"
    ;;
  starvation-snapshot)
    collect_starvation_state \
      "${2:?label required}" \
      "${3:-}" \
      "${4:-180}"
    ;;
  blocked)
    # Prints the D-state threads of PID, then the subset inside the NVIDIA
    # driver -- the same classification the monitor reboots on. Needs root:
    # the NVIDIA symbol list lives in the root-only runtime directory.
    # Exit 0: no NVIDIA wedge. 1: NVIDIA wedge. 2: bad PID, no such process,
    # or no symbol list, so a script cannot mistake "could not tell" for either.
    pid=${2:-}
    case "$pid" in ''|*[!0-9]*) echo "usage: $0 blocked PID" >&2; exit 2 ;; esac
    if [ ! -d "/proc/$pid" ]; then
      echo "no such process: $pid" >&2
      exit 2
    fi
    if ! load_nvidia_symbols; then
      echo "NVIDIA symbol list $NVIDIA_SYMBOLS_FILE unavailable (run as root, with the service started)" >&2
      exit 2
    fi
    blocked=$(blocked_threads "$pid")
    wedged=$(nvidia_wedged_threads "$blocked")
    printf 'blocked: %s\n' "${blocked:-none}"
    printf 'nvidia:  %s\n' "${wedged:-none}"
    [ -z "$wedged" ] || exit 1
    exit 0
    ;;
  nvidia-symbols)
    # Run by the unit's privileged ExecStartPre; see is_nvidia_wchan.
    write_nvidia_symbols
    ;;
  classify)
    # Prints "starved <evidence>" or "responsive <measurements>". Exits non-zero
    # when the machine is starved, so it can gate a shell command.
    classification=$(classify_system_load)
    printf '%s\n' "$classification"
    [ "${classification%% *}" != "starved" ]
    ;;
  *)
    echo "usage: $0 {monitor|active-uid|gnome-pid UID|probe UID|blocked PID|nvidia-symbols|classify|snapshot LABEL [UID] [PID] [LOOKBACK] [standard|full]|starvation-snapshot LABEL [REASON] [LOOKBACK]}" >&2
    exit 2
    ;;
esac
