#!/usr/bin/env bash
#
# Launch MATLAB from the host: private X server on the host side, MATLAB
# itself inside the distrobox.
#
# usage: fromelicks-matlab-launch [matlab args...]     (default: -desktop)
#
# xwayland-satellite has to run on the host (it is a client of the host
# compositor), MATLAB in the container (Fedora is not MathWorks-supported).
# They meet over the X socket in /tmp, which distrobox shares.
#
# Not a distrobox-exported app: an exported entry would run `distrobox enter`
# with no X server at all under GNOME's default --no-x11.
#
# See docs/matlab-distrobox.md.

set -euo pipefail

readonly PROG="${0##*/}"
LIBEXEC="$(dirname "$(readlink -f "$0")")"
readonly LIBEXEC
readonly XRUN="${LIBEXEC}/fromelicks-xwayland-isolated"

# shellcheck source=fromelicks-matlab-env
source "${LIBEXEC}/fromelicks-matlab-env"

fail() { printf '%s: %s\n' "${PROG}" "$*" >&2; exit 1; }

[[ -x "${XRUN}" ]] || fail "${XRUN} is missing"

matlab_installed ||
    fail "MATLAB ${MATLAB_RELEASE} is not installed in ${MATLAB_INSTALL_DIR}. Run 'ujust matlab-install'."
matlab_box_exists ||
    fail "the '${MATLAB_BOX}' container does not exist. Run 'ujust matlab-box'."

(( $# )) || set -- -desktop

# Escape hatch for OpenGL trouble, e.g. host NVIDIA libraries shadowing the
# container's libGL when the manifest sets nvidia=true.
if [[ "${FROMELICKS_MATLAB_SOFTWARE_OPENGL:-0}" == '1' ]]; then
    set -- -softwareopengl "$@"
fi

# LD_PRELOAD and SHELL are fixed inside the container by the /usr/local/bin
# wrapper, since `distrobox enter` re-exports the host environment.
exec "${XRUN}" distrobox enter --name "${MATLAB_BOX}" -- /usr/local/bin/matlab "$@"
